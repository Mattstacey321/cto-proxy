# Required: Your refresh token from the cto/opencode CLI
# Find it in Proxyman by watching for POST /oauth/token on api.enginelabs.ai
ENGINELABS_REFRESH_TOKEN=your_refresh_token_here

# Optional: Override the upstream URL (defaults to https://api.enginelabs.ai)
# UPSTREAM_URL=https://api.enginelabs.ai

# Optional: Override the proxy port (defaults to 3112)
# PORT=3112
